function drawCharacterCard(charData, x, y, w, h) {
  let selected = selectedCharacterId === charData.id;
  let hovering = mouseOverRect(x, y, w, h);

  drawCardGlow(x, y, w, h, charData.accent, selected ? 1 : (hovering ? 0.7 : 0.35));
  drawPanel(x, y, w, h);

  if (selected) {
    noFill();
    stroke(charData.accent[0], charData.accent[1], charData.accent[2], 220);
    strokeWeight(2);
    rect(x + 3, y + 3, w - 6, h - 6, 14);
  }

  drawCharacterPortrait(charData, x + 118, y + 34, 110, false);

  setTextStyle(25, BOLD, LEFT, TOP, 28, color(255));
  text(charData.name, x + 28, y + 180);

  setTextStyle(14, NORMAL, LEFT, TOP, 22, color(210));
  text(charData.desc, x + 28, y + 222);

  setTextStyle(13, NORMAL, LEFT, TOP, 21, color(190));
  text(
    "Reserved for future art replacement.\nCurrent version uses simple color coding.",
    x + 28,
    y + 266
  );

  addMenuButton(x + 28, y + h - 52, w - 56, 40, selected ? "Selected" : "Select Character", () => {
    selectedCharacterId = charData.id;
    savePersistentState();
    showFlash(`${charData.name} selected`, true);
    playEquipTone();
  }, [50, 150, 100], !selected);
}

function drawCharacterPortrait(charData, x, y, size, highlight) {
  push();

  let pulse = highlight ? sin(uiTime * 1.6) * 4 : 0;

  noStroke();
  fill(0, 0, 0, 45);
  ellipse(x + size / 2, y + size + 18, size * 0.56, 16);

  fill(charData.accent[0], charData.accent[1], charData.accent[2], 30);
  circle(x + size / 2, y + size / 2, size + 28 + pulse);

  fill(charData.body[0], charData.body[1], charData.body[2]);
  ellipse(x + size / 2, y + 72, 50, 62);

  fill(255, 220, 177);
  ellipse(x + size / 2, y + 35, 38, 38);

  fill(0);
  ellipse(x + size / 2 - 7, y + 33, 4, 4);
  ellipse(x + size / 2 + 7, y + 33, 4, 4);

  fill(charData.accent[0], charData.accent[1], charData.accent[2]);
  rect(x + size / 2 - 12, y + 58, 24, 8, 4);

  pop();
}

