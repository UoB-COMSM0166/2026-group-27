function drawShopCard(item, index, x, y, w, h) {
  let selected = equippedGunLevel === item.level;
  let hovering = mouseOverRect(x, y, w, h);

  drawCardGlow(x, y, w, h, item.accent, selected ? 1 : (hovering ? 0.7 : 0.35));
  drawPanel(x, y, w, h);

  drawWeaponIcon(item, x + 28, y + 34, 100, 100);

  setTextStyle(30, BOLD, LEFT, TOP, 32, color(255));
  text(item.name, x + 146, y + 36);

  setTextStyle(14, NORMAL, LEFT, TOP, 22, color(210));
  text(item.desc, x + 146, y + 82);

  let tagText = "";
  let tagColor = [90, 90, 110];

  if (equippedGunLevel === item.level) {
    tagText = "EQUIPPED";
    tagColor = [40, 150, 90];
  } else if (ownedGunLevel >= item.level) {
    tagText = "OWNED";
    tagColor = [70, 100, 160];
  } else {
    tagText = `PRICE £${item.price}`;
    tagColor = [130, 90, 40];
  }

  drawTag(tagText, x + 146, y + 120, tagColor);

  setTextStyle(15, NORMAL, LEFT, TOP, 26, color(235));
  text(`Damage: ${item.damage}`, x + 28, y + 182);
  text(`Bullet Speed: ${item.speed}`, x + 28, y + 214);
  text(`Cooldown: ${item.cooldown}s`, x + 28, y + 246);

  let canBuy = ownedGunLevel < item.level;
  let canEquip = ownedGunLevel >= item.level && equippedGunLevel !== item.level;

  addMenuButton(x + 34, y + 252, 136, 40, canBuy ? "Buy" : "Purchased", () => {
    tryBuy(index);
  }, [40, 110, 220], canBuy);

  addMenuButton(x + 190, y + 252, 136, 40, equippedGunLevel === item.level ? "Equipped" : "Equip", () => {
    tryEquip(index);
  }, [30, 150, 100], canEquip);
}

