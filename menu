  let levelName = levelData[levelNumber - 1].title;
  showFlash(`${levelName} launch placeholder ready`, true);
}

// ==================== 商城逻辑 / Shop Logic ====================

function tryBuy(index) {
  let item = shopItems[index];

  if (ownedGunLevel >= item.level) {
    showFlash("Already purchased", false);
    playFailTone();
    return;
  }

  if (coins < item.price) {
    showFlash("Not enough coins", false);
    playFailTone();
    return;
  }

  coins -= item.price;
  ownedGunLevel = item.level;
  savePersistentState();

  showFlash(`Purchased ${item.name}`, true);
  playBuyTone();
}

function tryEquip(index) {
  let item = shopItems[index];

  if (ownedGunLevel < item.level) {
    showFlash("Buy it first", false);
    playFailTone();
    return;
  }

  if (equippedGunLevel === item.level) {
    showFlash("Already equipped", false);
    playHoverTone();
    return;
  }

  equippedGunLevel = item.level;
  savePersistentState();

  showFlash(`Equipped ${item.name}`, true);
  playEquipTone();
}

// ==================== UI 组件 / UI Components ====================

function addMenuButton(x, y, w, h, label, action, colorArr, enabled = true) {
  let hovered = mouseOverRect(x, y, w, h);

  currentButtons.push({
    x, y, w, h, label, action, colorArr, enabled
  });

  drawButton(x, y, w, h, label, enabled, hovered, colorArr);
}

function drawButton(x, y, w, h, label, enabled, hovered, baseColor) {
  let c = enabled ? baseColor : [95, 100, 115];
  let brighten = hovered && enabled ? 22 : 0;

  noStroke();
  fill(c[0] + brighten, c[1] + brighten, c[2] + brighten);
  rect(x, y, w, h, 12);

  fill(255, 255, 255, hovered ? 28 : 16);
  rect(x + 2, y + 2, w - 4, 11, 10);

  setTextStyle(14, NORMAL, CENTER, CENTER, 18, color(255));
  text(label, x + w / 2, y + h / 2 + 1);
}

function drawPanel(x, y, w, h) {
  noStroke();
  fill(24, 30, 45, 235);
  rect(x, y, w, h, 18);

  fill(255, 255, 255, 10);
  rect(x + 4, y + 4, w - 8, 22, 12);
}

function drawCardGlow(x, y, w, h, accent, strength) {
  if (strength <= 0) return;

  noStroke();
  fill(accent[0], accent[1], accent[2], 16 * strength);
  rect(x - 6, y - 6, w + 12, h + 12, 22);
}

function drawTag(label, x, y, c) {
  noStroke();
  fill(c[0], c[1], c[2], 215);
  rect(x, y, 132, 30, 999);

  setTextStyle(13, NORMAL, CENTER, CENTER, 16, color(255));
  text(label, x + 66, y + 15);
}

// ==================== 武器图形 / Weapon Graphics ====================

function drawWeaponIcon(item, x, y, w, h) {
  noStroke();
  fill(10, 18, 34);
  rect(x, y, w, h, 16);

  push();
  translate(x + w / 2, y + h / 2);
  scale(1.05);
  drawGunModel(item, 0, 0, 1);
  pop();
}

function drawGunModel(item, x, y, s = 1) {
  push();
  translate(x, y);
  scale(s);

  let body = item.color;
  let accent = item.accent;

  noStroke();

  fill(body[0], body[1], body[2]);
  rect(-36, -6, 52, 12, 4);
  rect(12, -4, 16, 8, 3);
  rect(-20, 6, 10, 20, 4);

  fill(accent[0], accent[1], accent[2]);
  rect(-28, -10, 18, 5, 3);
  rect(-2, -3, 10, 6, 2);

  fill(255, 255, 255, 40);
  rect(-34, -4, 18, 3, 2);

  pop();
}

function drawGunShowcaseModel(item) {
  let body = item.color;
  let accent = item.accent;

  let yaw = sin(uiTime) * 0.9;
  let bob = sin(uiTime * 1.4) * 4;

  let bodyLen = 78 + cos(uiTime) * 10;
  let barrelLen = 26 + cos(uiTime) * 6;

  rotate(-0.28);
  translate(0, bob);

  noStroke();

  push();
  fill(0, 0, 0, 35);
  rect(-bodyLen * 0.55 + 3, -8 + 3, bodyLen, 16, 6);
  rect(bodyLen * 0.12 + 3, -5 + 3, barrelLen, 10, 4);
  rect(-18 + 3, 8 + 3, 14, 32, 6);
  pop();

  fill(body[0], body[1], body[2]);
  rect(-bodyLen * 0.55, -8, bodyLen, 16, 6);
  rect(bodyLen * 0.12, -5, barrelLen, 10, 4);
  rect(-18, 8, 14, 32, 6);
  rect(-bodyLen * 0.55 - 12, -4, 16, 8, 4);

  fill(accent[0], accent[1], accent[2], 230);
  rect(-bodyLen * 0.38, -12, bodyLen * 0.34, 6, 4);
  rect(-4, -4, 14, 8, 3);

  fill(255, 255, 255, 60);
  rect(bodyLen * 0.18, -3, barrelLen * 0.45, 3, 2);

  fill(
    max(body[0] - 25, 0),
    max(body[1] - 25, 0),
    max(body[2] - 25, 0)
  );
  quad(
    -bodyLen * 0.55, 8,
    bodyLen * 0.45, 8,
    bodyLen * 0.45 + yaw * 7, 14,
    -bodyLen * 0.55 + yaw * 7, 14
  );

  quad(
    -18, 40,
    -4, 40,
    -4 + yaw * 3, 46,
    -18 + yaw * 3, 46
  );

  fill(255, 255, 255, 70);
  ellipse(-bodyLen * 0.08, -1, 10, 6);
}

// ==================== 文本工具 / Text Helpers ====================

function setTextStyle(size, styleMode, alignX, alignY, leadingValue, fillColor) {
  textSize(size);
  textStyle(styleMode);
  textAlign(alignX, alignY);
  textLeading(leadingValue);
  fill(fillColor);
  noStroke();
}

function drawBulletParagraph(lines, x, y, maxWidth, lineGap, countLimit = null) {
  let items = countLimit === null ? lines : lines.slice(0, countLimit);
  let yy = y;

  for (let line of items) {
    text("• " + line, x, yy, maxWidth);
    yy += lineGap * 2;
  }
}

function drawPlainParagraph(lines, x, y, maxWidth, lineGap) {
  let yy = y;
  for (let line of lines) {
    text(line, x, yy, maxWidth);
    yy += lineGap * 1.6;
  }
}

