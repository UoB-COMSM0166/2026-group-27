function drawMaze() {
    // 绘制地面
    for (let t of terrain) {
        drawTerrain(t.left - cam.x, t.top - cam.y);
    }
    
    // 绘制墙壁
    for (let w of wall) {
        drawWall(w.left - cam.x, w.top - cam.y);
    }
    
    // 绘制水
    for (let w of water) {
        drawWater(w.left - cam.x, w.top - cam.y);
    }
}

function drawMiniMap() {
    let miniMapBorder = 5;
    let miniMapLeft = 10;
    let miniMapTop = height - mazeMap.gridW * miniMapScale - 10 - miniMapBorder;
    
    fill(255);
    noStroke();
    rect(miniMapLeft, miniMapTop, 
         mazeMap.gridH * miniMapScale + 10, 
         mazeMap.gridW * miniMapScale + 10);
    
    fill(232, 224, 160);
    rect(miniMapLeft + miniMapBorder, miniMapTop + miniMapBorder, 
         mazeMap.gridH * miniMapScale, 
         mazeMap.gridW * miniMapScale);
    
    fill(0);
    for (let w of wall) {
        rect((w.left / blockSize) * miniMapScale + miniMapLeft + miniMapBorder,
             (w.top / blockSize) * miniMapScale + miniMapTop + miniMapBorder,
             miniMapScale, miniMapScale);
    }
    
    // 玩家
    fill(255, 0, 0);
    noStroke();
    circle((player.left / blockSize) * miniMapScale + miniMapLeft + miniMapBorder + 1,
           (player.top / blockSize) * miniMapScale + miniMapTop + miniMapBorder + 1, 4);
    
    // 呼吸管
    fill(0, 255, 0);
    circle((snorkel.left / blockSize) * miniMapScale + miniMapLeft + miniMapBorder + 1,
           (snorkel.top / blockSize) * miniMapScale + miniMapTop + miniMapBorder + 1, 4);
    
    // 脚蹼
    circle((flipper.left / blockSize) * miniMapScale + miniMapLeft + miniMapBorder + 1,
           (flipper.top / blockSize) * miniMapScale + miniMapTop + miniMapBorder + 1, 4);
}

