    let miniMapTop = height - mazeMap.gridH * miniMapScale - 10 - miniMapBorder;

    fill(255);
    noStroke();
    rect(
        miniMapLeft,
        miniMapTop,
        mazeMap.gridW * miniMapScale + 10,
        mazeMap.gridH * miniMapScale + 10
    );

    fill(210);
    rect(
        miniMapLeft + miniMapBorder,
        miniMapTop + miniMapBorder,
        mazeMap.gridW * miniMapScale,
        mazeMap.gridH * miniMapScale
    );

    fill(0);
    for (let w of wall) {
        rect(
            (w.left / blockSize) * miniMapScale + miniMapLeft + miniMapBorder,
            (w.top / blockSize) * miniMapScale + miniMapTop + miniMapBorder,
            miniMapScale,
            miniMapScale
        );
    }

    fill(bossDefeated ? color(0, 200, 0) : color(180, 40, 40));
    rect(
        (exitDoor.left / blockSize) * miniMapScale + miniMapLeft + miniMapBorder,
        (exitDoor.top / blockSize) * miniMapScale + miniMapTop + miniMapBorder,
        miniMapScale,
        miniMapScale
