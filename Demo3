function drawMiniMap() {
    let miniMapBorder = 5;
    let miniMapLeft = 10;
    let miniMapTop = height - mazeMap.gridH * miniMapScale - 10 - miniMapBorder;

    fill(255);
    noStroke();
    rect(miniMapLeft, miniMapTop, mazeMap.gridW * miniMapScale + 10, mazeMap.gridH * miniMapScale + 10);

    fill(210);
    rect(miniMapLeft + miniMapBorder, miniMapTop + miniMapBorder, mazeMap.gridW * miniMapScale, mazeMap.gridH * miniMapScale);

    fill(0);
    for (let w of wall) {
        rect(
            (w.left / blockSize) * miniMapScale + miniMapLeft + miniMapBorder,
            (w.top / blockSize) * miniMapScale + miniMapTop + miniMapBorder,
            miniMapScale,
            miniMapScale
        );
    }

    fill(150, 80, 255);
    for (let p of portals) {
        circle(
            (p.left / blockSize) * miniMapScale + miniMapLeft + miniMapBorder + 1,
            (p.top / blockSize) * miniMapScale + miniMapTop + miniMapBorder + 1,
            4
        );
    }

    fill(bossDefeated ? 0 : 180, bossDefeated ? 200 : 40, 40);
    rect(
        (exitDoor.left / blockSize) * miniMapScale + miniMapLeft + miniMapBorder,
        (exitDoor.top / blockSize) * miniMapScale + miniMapTop + miniMapBorder,
        miniMapScale,
        miniMapScale
    );

    if (!hasLamp) {
        fill(255, 220, 0);
        circle(
            (lampItem.left / blockSize) * miniMapScale + miniMapLeft + miniMapBorder + 1,
            (lampItem.top / blockSize) * miniMapScale + miniMapTop + miniMapBorder + 1,
            4
        );
    }

    if (!hasGun) {
        fill(0, 120, 255);
        circle(
            (gunItem.left / blockSize) * miniMapScale + miniMapLeft + miniMapBorder + 1,
            (gunItem.top / blockSize) * miniMapScale + miniMapTop + miniMapBorder + 1,
            4
        );
    }

    fill(180, 0, 180);
    for (let e of enemies) {
        circle(
            (e.rect.left / blockSize) * miniMapScale + miniMapLeft + miniMapBorder + 1,
            (e.rect.top / blockSize) * miniMapScale + miniMapTop + miniMapBorder + 1,
            3
        );
    }

    if (boss && boss.alive) {
        fill(90, 0, 150);
        circle(
            (boss.rect.left / blockSize) * miniMapScale + miniMapLeft + miniMapBorder + 1,
            (boss.rect.top / blockSize) * miniMapScale + miniMapTop + miniMapBorder + 1,
            5
        );
    }

    fill(255, 0, 0);
    circle(
        (player.left / blockSize) * miniMapScale + miniMapLeft + miniMapBorder + 1,
        (player.top / blockSize) * miniMapScale + miniMapTop + miniMapBorder + 1,
        4
    );
}

function drawElapsedTime() {
    fill(0);
    noStroke();
    rect(width / 2 - 37, 5, 74, 42);

    fill(255);
    rect(width / 2 - 32, 10, 64, 32);

    fill(0);
    textAlign(CENTER);
    textSize(20);
    textFont('Arial');
    text(convertTime(elapsedTime), width / 2, 32);
    textAlign(LEFT);
}

// ==================== 重置 / Reset ====================
function resetGame() {
    gTime = 0;
    elapsedTime = 0;
    lastKeyPress = null;
    pause = true;
    gameover = false;
    start = true;
    end = false;
    moving = false;

    wall = [];
    terrain = [];
    dir = 0;

    box = null;
    lampItem = null;
    gunItem = null;
    exitDoor = null;

    portals = [];
    bullets = [];
    enemyProjectiles = [];
    enemies = [];
    boss = null;

    hasMiniMap = false;
    hasLamp = false;
    hasGun = false;
    showMiniMap = true;
    bossDefeated = false;

    playerHp = playerMaxHp;
    playerInvulnTimer = 0;
    shootCooldownTimer = 0;
    teleportCooldownTimer = 0;

    smallKillCount = 0;
    bossKillCount = 0;
    coinsEarnedThisRun = 0;

    endTimePopUp = 0;
    popUpTitle = '';
    popUpMessage = '';
    gameoverMsg = '';
    endTimeInformation = 0;

    setup();
}
